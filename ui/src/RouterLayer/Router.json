{
    "routes": [
        { "type": "redirect", "from": "/", "to": "/home/" },
        { "type": "domain", "path": "/login", "component": "LoginPage", "title": "Login",
            "children": [  { "path": "blank", "component": "LoginPage", "title": "Login" ,"type": "page"}]},
        { "type": "domain", "path": "/register", "component": "RegisterPage", "title": "Register",
            "children": [  { "path": "blank", "component": "BlankPage", "title": "Blank" ,"type": "page"}]},
        {
            "type": "domain",
            "path": "/home",
            "component": "HomeLayout",
            "children": [
                { "path": "personal", "component": "PersonalPage", "title": "Personal" ,"type": "page"},
                { "path": "widget", "component": "WidgetMainPage", "title": "Widget" ,"type": "page"},
                { "path": "contact", "component": "ContactPage", "title": "Contact" ,"type": "page"},
                { "path": "profile", "component": "ProfilePage", "title": "Profile","type": "page"}
            ]
        },
        {
            "type": "domain",
            "path": "/admin",
            "component": "AdminLayout",
            "children": [  { "path": "blank", "component": "BlankPage", "title": "Blank" ,"type": "page"}]
        },
        {
            "type": "domain",
            "path": "/blog",
            "component": "BlogLayout",
            "children": [  { "path": "blank", "component": "BlankPage", "title": "Blank" ,"type": "page"}]
        }
    ],
    "error": {
        "path": "*",
        "component": "NotFoundPage",
        "title": "Page Not Found"
    }
}